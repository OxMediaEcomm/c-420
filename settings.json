{
  "model": "claude-sonnet-5",
  "effortLevel": "medium",
  "env": {
    "C420_HOME": "__C420_HOME__",
    "PROJECTS_ROOT": "__PROJECTS_ROOT__",
    "MEMORY_SNAPSHOT_PATH": "__C420_HOME__/memory/last_session.md",
    "C420_CONTEXT_WINDOW": "200000",
    "STATUSLINE_NAME": "Your Name",
    "STATUSLINE_EMAIL": "you@your-domain.com"
  },
  "statusLine": {
    "type": "command",
    "command": "bash __C420_HOME__/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash __C420_HOME__/hooks/session-end.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __C420_HOME__/skills/continuous-learning-v2/hooks/observe.sh pre"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash __C420_HOME__/skills/continuous-learning-v2/hooks/observe.sh post"
          },
          {
            "type": "command",
            "command": "node __C420_HOME__/hooks/context-guard.mjs"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "context-mode": {
      "command": "<PATH_TO_YOUR_CONTEXT_MODE_CLI>/context-mode.cmd",
      "type": "stdio"
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "type": "stdio"
    },
    "magicui": {
      "command": "npx",
      "args": [
        "-y",
        "@magicuidesign/mcp@latest"
      ],
      "type": "stdio"
    },
    "puppeteer": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-puppeteer"
      ],
      "type": "stdio"
    },
    "21st-dev": {
      "command": "__C420_HOME__/mcp-servers/21st-magic-wrapper.cmd",
      "type": "stdio"
    },
    "supabase": {
      "command": "__C420_HOME__/mcp-servers/supabase-mcp-wrapper.cmd",
      "type": "stdio"
    }
  }
}
