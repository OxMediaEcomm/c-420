# Schwiftyy Brain Starter — Configuration
# Copy this file to .env (and/or export these as real environment variables
# in your shell profile) and fill in your own values.
# cp .env.example .env

# === Required: paths (this config references itself and your project tree) ===
# Root folder where your own projects/repos live.
PROJECTS_ROOT=C:\Users\YOUR_USERNAME\Projects

# Root folder where this Claude config (agents/commands/hooks/rules/skills) lives.
# Settings.json and several skill files reference ${CLAUDE_CONFIG_DIR} for
# hook/script paths.
CLAUDE_CONFIG_DIR=C:\Users\YOUR_USERNAME\.claude

# Default root for one-off client/design projects created by schwifty-design.
CLIENT_PROJECTS_ROOT=C:\Users\YOUR_USERNAME\Client Projects

# Desktop path used by wp-elementor-mcp-connect for the self-serve delivery kit.
DESKTOP_DIR=C:\Users\YOUR_USERNAME\Desktop

# === Required: persistent memory store ===
# Path to the rolling session-memory file used by hooks/session-end.sh,
# hooks/context-guard.mjs, and skills/session-memory-snapshot.
MEMORY_SNAPSHOT_PATH=C:\Users\YOUR_USERNAME\.claude\memory\last_session.md

# Path to the broader project/user/feedback memory store (auto-memory system).
CLAUDE_MEMORY_STORE_PATH=~/.claude-memory-store/projects/<encoded-cwd>/memory

# === Optional: statusline identity (statusline.sh) ===
STATUSLINE_NAME=Your Name
STATUSLINE_EMAIL=you@your-domain.com

# === Secrets (REQUIRED for the MCP servers that use them — generate/obtain your own) ===
# Used by mcp-servers/21st-magic-wrapper.cmd
TWENTYFIRST_API_KEY=change-me-to-your-21st-dev-api-key

# Used by mcp-servers/supabase-mcp-wrapper.cmd
SUPABASE_ACCESS_TOKEN=change-me-to-your-supabase-access-token

# Path to your own local "context-mode" CLI, referenced in settings.json's
# mcpServers.context-mode entry. Remove that mcpServer block entirely if you
# don't use this tool.
# (not an env var consumed by settings.json directly — settings.json uses a
# literal placeholder path; edit it in place once you know your own path)
# PATH_TO_YOUR_CONTEXT_MODE_CLI=D:\Your\Path\To\context-mode-cli
